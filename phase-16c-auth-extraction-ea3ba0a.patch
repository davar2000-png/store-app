+# -*- coding: utf-8 -*-
+"""Phase 16C — تست‌های web_session_service (Session Login وب، مستقل از Sessions دسکتاپ)."""
+
+import services.web_session_service as web_session_service
+
+
+class FakeWebSessionDatabase:
+    sessions = {}   # token -> {"UserRef": int, "expired": bool}
+    users = {}      # user_id -> dict
+
+    def __init__(self):
+        pass
+
+    @classmethod
+    def reset(cls, users=None):
+        cls.sessions = {}
+        cls.users = users if users is not None else {}
+
+    def execute(self, sql, params=()):
+        normalized = " ".join(sql.split()).upper()
+
+        if normalized.startswith("INSERT INTO WEBSESSIONS"):
+            token, user_id, hours = params
+            self.__class__.sessions[token] = {"UserRef": user_id, "expired": False}
+            return
+
+        if normalized.startswith("DELETE FROM WEBSESSIONS"):
+            token = params[0]
+            self.__class__.sessions.pop(token, None)
+            return
+
+        raise AssertionError(f"Unsupported execute SQL: {sql}")
+
+    def fetch_one(self, sql, params=()):
+        normalized = " ".join(sql.split()).upper()
+
+        if normalized.startswith("SELECT * FROM WEBSESSIONS"):
+            token = params[0]
+            row = self.__class__.sessions.get(token)
+            if not row or row["expired"]:
+                return None
+            return {"Token": token, "UserRef": row["UserRef"]}
+
+        if normalized.startswith("SELECT * FROM USERS WHERE ID"):
+            user_id = params[0]
+            return self.__class__.users.get(user_id)
+
+        raise AssertionError(f"Unsupported fetch_one SQL: {sql}")
+
+    def close(self):
+        pass
+
+
+def setup_function():
+    FakeWebSessionDatabase.reset(users={1: {"ID": 1, "Username": "ali", "IsActive": True}})
+    web_session_service.Database = FakeWebSessionDatabase
+
+
+def test_create_web_session_returns_token_and_stores_it():
+    token = web_session_service.create_web_session(1)
+
+    assert token
+    assert FakeWebSessionDatabase.sessions[token]["UserRef"] == 1
+
+
+def test_get_user_for_token_returns_user_for_valid_token():
+    token = web_session_service.create_web_session(1)
+
+    user = web_session_service.get_user_for_token(token)
+
+    assert user["ID"] == 1
+    assert user["Username"] == "ali"
+
+
+def test_get_user_for_token_returns_none_for_missing_token():
+    assert web_session_service.get_user_for_token("not-a-real-token") is None
+
+
+def test_get_user_for_token_returns_none_for_empty_token():
+    assert web_session_service.get_user_for_token("") is None
+    assert web_session_service.get_user_for_token(None) is None
+
+
+def test_get_user_for_token_returns_none_for_expired_session():
+    token = web_session_service.create_web_session(1)
+    FakeWebSessionDatabase.sessions[token]["expired"] = True
+
+    assert web_session_service.get_user_for_token(token) is None
+
+
+def test_destroy_web_session_invalidates_token():
+    token = web_session_service.create_web_session(1)
+
+    web_session_service.destroy_web_session(token)
+
+    assert web_session_service.get_user_for_token(token) is None
+
+
+def test_destroy_web_session_is_safe_for_missing_token():
+    # نباید Exception بیندازد حتی اگر Token از قبل وجود نداشته باشد.
+    web_session_service.destroy_web_session("does-not-exist")
+    web_session_service.destroy_web_session(None)
+
+
+def test_each_created_session_gets_a_unique_token():
+    token1 = web_session_service.create_web_session(1)
+    token2 = web_session_service.create_web_session(1)
+
+    assert token1 != token2
