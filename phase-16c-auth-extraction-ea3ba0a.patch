+-- =========================================================
+-- Phase 16C — Auth Extraction + Session Login (Web)
+-- =========================================================
+-- این Migration فقط یک جدول جدید اضافه می‌کند و به هیچ جدول موجودی
+-- (Users, Sessions و غیره) دست نمی‌زند.
+--
+-- WebSessions کاملاً مستقل از جدول Sessions (ساخته‌شده در
+-- database/migrations/007_session_recovery.sql) است:
+--   - Sessions (Phase 12) برای ردیابی چرخه‌ی اجرای برنامه‌ی دسکتاپ است
+--     (Heartbeat, Crash Detection, AutoSave) و هیچ ربطی به احراز هویت
+--     ندارد.
+--   - WebSessions فقط برای Session Login مرورگر است: یک Token تصادفی
+--     Cookie-based که به یک کاربر و یک زمان انقضا وصل است.
+-- این دو مفهوم عمداً در دو جدول جدا نگه داشته شده‌اند تا هیچ‌کدام رفتار
+-- دیگری را تحت تأثیر قرار ندهد.
+-- =========================================================
+
+USE StoreAppDB;
+GO
+
+IF OBJECT_ID('WebSessions', 'U') IS NULL
+BEGIN
+    CREATE TABLE WebSessions (
+        Token       NVARCHAR(64)  NOT NULL PRIMARY KEY,
+        UserRef     INT           NOT NULL FOREIGN KEY REFERENCES Users(ID),
+        CreatedAt   DATETIME2     NOT NULL DEFAULT GETDATE(),
+        ExpiresAt   DATETIME2     NOT NULL
+    );
+    CREATE INDEX IX_WebSessions_UserRef ON WebSessions(UserRef);
+    CREATE INDEX IX_WebSessions_ExpiresAt ON WebSessions(ExpiresAt);
+END
+GO
+
+PRINT N'✅ جدول Phase 16C (WebSessions) با موفقیت ساخته شد.';
