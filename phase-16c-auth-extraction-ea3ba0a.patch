+# -*- coding: utf-8 -*-
+"""
+Web Session Service — Session Login مبتنی بر Cookie برای وب (Phase 16C)
+
+⚠️ این ماژول با ``services/session_service.py`` (Phase 12 — چرخه‌ی اجرای
+برنامه‌ی دسکتاپ: Heartbeat/Crash Detection/AutoSave) کاملاً بی‌ربط است و
+جدول جداگانه‌ی خودش (``WebSessions`` — ساخته‌شده در
+``database/migrations/015_web_sessions.sql``) را دارد. هیچ‌کدام از این
+دو به دیگری وابسته نیست.
+
+Token یک رشته‌ی تصادفی امن (``secrets.token_urlsafe``) است که در یک
+Cookie با ``HttpOnly`` روی مرورگر کاربر ذخیره می‌شود؛ خود Session کاملاً
+Server-side است (فقط Token در WebSessions جست‌وجو می‌شود، نه هیچ داده‌ی
+دیگری در Cookie).
+"""
+
+import sys
+import os
+import secrets
+
+sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from database.db import Database
+
+SESSION_DURATION_HOURS = 12
+COOKIE_NAME = "storeapp_web_session"
+
+
+def create_web_session(user_id: int) -> str:
+    """یک Session وب جدید برای این کاربر می‌سازد و Token آن را برمی‌گرداند."""
+    token = secrets.token_urlsafe(32)
+
+    db = Database()
+    try:
+        db.execute(
+            "INSERT INTO WebSessions (Token, UserRef, CreatedAt, ExpiresAt) "
+            "VALUES (?, ?, GETDATE(), DATEADD(HOUR, ?, GETDATE()))",
+            (token, user_id, SESSION_DURATION_HOURS),
+        )
+    finally:
+        db.close()
+
+    return token
+
+
+def get_user_for_token(token: str):
+    """
+    اگر Token معتبر و هنوز منقضی‌نشده باشد، رکورد کاربر فعال متناظر را
+    برمی‌گرداند؛ در غیر این صورت ``None``.
+    """
+    if not token:
+        return None
+
+    db = Database()
+    try:
+        session_row = db.fetch_one(
+            "SELECT * FROM WebSessions WHERE Token = ? AND ExpiresAt > GETDATE()",
+            (token,),
+        )
+        if not session_row:
+            return None
+
+        user = db.fetch_one(
+            "SELECT * FROM Users WHERE ID = ? AND IsActive = 1",
+            (session_row["UserRef"],),
+        )
+        return user
+    finally:
+        db.close()
+
+
+def destroy_web_session(token: str) -> None:
+    """Session را باطل می‌کند (Logout). اگر Token از قبل معتبر نباشد، بی‌اثر است."""
+    if not token:
+        return
+
+    db = Database()
+    try:
+        db.execute("DELETE FROM WebSessions WHERE Token = ?", (token,))
+    finally:
+        db.close()
