+# -*- coding: utf-8 -*-
+"""
+Auth Service — منطق مشترک احراز هویت (Phase 16C)
+
+این ماژول دقیقاً همان منطقی را پیاده می‌کند که قبلاً مستقیم داخل
+``ui/login_window.py`` قفل شده بود (خواندن کاربر با Username/IsActive و
+بررسی رمز با ``utils.security.verify_password``)، اما به‌صورت یک تابع
+خالص و کاملاً مستقل از UI (بدون هیچ وابستگی به PyQt یا FastAPI) تا هم
+پنجره‌ی دسکتاپ و هم Session Login وب از یک منبع واحد استفاده کنند —
+نه دو پیاده‌سازی موازی.
+
+پیام‌های خطا عیناً همان متن‌های قبلی ``login_window.py`` هستند تا رفتار
+دیده‌شده توسط کاربر دسکتاپ هیچ تغییری نکند.
+
+تغییر رفتاری جدید (additive، چیزی را نمی‌شکند): بعد از ورود موفق،
+``Users.LastLogin`` به‌روزرسانی می‌شود — ستونی که در Schema از قبل وجود
+داشت اما تا این فاز توسط هیچ کدی مقداردهی نمی‌شد. اگر این به‌روزرسانی با
+خطا مواجه شود، ورود کاربر را مسدود نمی‌کند (فقط نادیده گرفته می‌شود).
+"""
+
+import sys
+import os
+
+sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from database.db import Database
+from utils.security import verify_password
+
+
+class AuthError(Exception):
+    """پایه‌ی خطاهای احراز هویت. متن پیام مستقیماً برای نمایش به کاربر مناسب است."""
+
+
+class InvalidCredentials(AuthError):
+    """فیلدها خالی‌اند، یا نام‌کاربری یافت نشد/غیرفعال است."""
+
+
+class WrongPassword(AuthError):
+    """نام‌کاربری معتبر است اما رمز عبور اشتباه است."""
+
+
+def authenticate(username: str, password: str) -> dict:
+    """
+    نام‌کاربری و رمز را دقیقاً طبق همان قانون قبلی ``login_window.py``
+    بررسی می‌کند:
+
+    1) اگر فیلدها خالی باشند -> ``InvalidCredentials``
+    2) اگر کاربر با این Username و IsActive=1 پیدا نشود -> ``InvalidCredentials``
+    3) اگر رمز اشتباه باشد -> ``WrongPassword``
+    4) در غیر این صورت رکورد کامل کاربر (dict) برگردانده می‌شود.
+
+    خطاهای اتصال به دیتابیس (مثلاً نبود ODBC/SQL Server) عمداً اینجا catch
+    نمی‌شوند و همان‌طور که هستند بالا می‌روند، تا caller (UI دسکتاپ یا وب)
+    بتواند مثل قبل پیام «خطای اتصال» جداگانه نشان دهد.
+    """
+    username = (username or "").strip()
+    password = password or ""
+
+    if not username or not password:
+        raise InvalidCredentials("لطفاً نام کاربری و رمز عبور را وارد کنید.")
+
+    db = Database()
+    try:
+        user = db.fetch_one(
+            "SELECT * FROM Users WHERE Username = ? AND IsActive = 1", (username,)
+        )
+
+        if not user:
+            raise InvalidCredentials("نام کاربری یافت نشد یا غیرفعال است.")
+
+        if not verify_password(password, user["PasswordHash"], user["PasswordSalt"]):
+            raise WrongPassword("رمز عبور اشتباه است.")
+
+        _touch_last_login(db, user["ID"])
+
+        return user
+    finally:
+        db.close()
+
+
+def _touch_last_login(db: Database, user_id: int) -> None:
+    """LastLogin را به‌روزرسانی می‌کند؛ شکست این کار هرگز ورود را نمی‌شکند."""
+    try:
+        db.execute("UPDATE Users SET LastLogin = GETDATE() WHERE ID = ?", (user_id,))
+    except Exception:
+        pass
