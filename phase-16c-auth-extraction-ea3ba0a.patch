+# -*- coding: utf-8 -*-
+"""
+Phase 16C — تست‌های auth_service.
+
+این تست‌ها منطق استخراج‌شده از ui/login_window.py را بدون هیچ وابستگی
+به PyQt یا دیتابیس واقعی بررسی می‌کنند.
+"""
+
+import pytest
+
+import services.auth_service as auth_service
+from services.auth_service import InvalidCredentials, WrongPassword
+from utils.security import hash_password
+
+
+class FakeAuthDatabase:
+    """Fake ساده و مخصوص این فایل تست؛ فقط SQLهایی که auth_service می‌زند."""
+
+    users = []
+    last_login_updates = []
+
+    def __init__(self):
+        pass
+
+    @classmethod
+    def reset(cls, users=None):
+        cls.users = users if users is not None else []
+        cls.last_login_updates = []
+
+    def fetch_one(self, sql, params=()):
+        normalized = " ".join(sql.split()).upper()
+        if normalized.startswith("SELECT * FROM USERS WHERE USERNAME"):
+            username = params[0]
+            for user in self.__class__.users:
+                if user["Username"] == username and user["IsActive"]:
+                    return dict(user)
+            return None
+        raise AssertionError(f"Unsupported fetch_one SQL: {sql}")
+
+    def execute(self, sql, params=()):
+        normalized = " ".join(sql.split()).upper()
+        if normalized.startswith("UPDATE USERS SET LASTLOGIN"):
+            self.__class__.last_login_updates.append(params[0])
+            return
+        raise AssertionError(f"Unsupported execute SQL: {sql}")
+
+    def close(self):
+        pass
+
+
+def _make_user(user_id=1, username="ali", password="secret123"):
+    hashed, salt = hash_password(password)
+    return {
+        "ID": user_id,
+        "Username": username,
+        "PasswordHash": hashed,
+        "PasswordSalt": salt,
+        "FullName": "علی محمدی",
+        "IsAdmin": False,
+        "IsActive": True,
+    }
+
+
+def setup_function():
+    FakeAuthDatabase.reset()
+    auth_service.Database = FakeAuthDatabase
+
+
+def test_authenticate_success_returns_user_and_updates_last_login():
+    user = _make_user()
+    FakeAuthDatabase.reset(users=[user])
+
+    result = auth_service.authenticate("ali", "secret123")
+
+    assert result["ID"] == 1
+    assert result["Username"] == "ali"
+    assert FakeAuthDatabase.last_login_updates == [1]
+
+
+def test_authenticate_empty_username_raises_invalid_credentials():
+    FakeAuthDatabase.reset(users=[_make_user()])
+
+    with pytest.raises(InvalidCredentials):
+        auth_service.authenticate("", "secret123")
+
+
+def test_authenticate_empty_password_raises_invalid_credentials():
+    FakeAuthDatabase.reset(users=[_make_user()])
+
+    with pytest.raises(InvalidCredentials):
+        auth_service.authenticate("ali", "")
+
+
+def test_authenticate_unknown_username_raises_invalid_credentials():
+    FakeAuthDatabase.reset(users=[_make_user()])
+
+    with pytest.raises(InvalidCredentials):
+        auth_service.authenticate("no-such-user", "secret123")
+
+
+def test_authenticate_inactive_user_raises_invalid_credentials():
+    user = _make_user()
+    user["IsActive"] = False
+    FakeAuthDatabase.reset(users=[user])
+
+    with pytest.raises(InvalidCredentials):
+        auth_service.authenticate("ali", "secret123")
+
+
+def test_authenticate_wrong_password_raises_wrong_password():
+    FakeAuthDatabase.reset(users=[_make_user()])
+
+    with pytest.raises(WrongPassword):
+        auth_service.authenticate("ali", "not-the-password")
+
+
+def test_authenticate_wrong_password_does_not_update_last_login():
+    FakeAuthDatabase.reset(users=[_make_user()])
+
+    with pytest.raises(WrongPassword):
+        auth_service.authenticate("ali", "not-the-password")
+
+    assert FakeAuthDatabase.last_login_updates == []
+
+
+def test_last_login_update_failure_does_not_block_login(monkeypatch):
+    user = _make_user()
+    FakeAuthDatabase.reset(users=[user])
+
+    def _boom(self, sql, params=()):
+        raise RuntimeError("simulated DB failure")
+
+    monkeypatch.setattr(FakeAuthDatabase, "execute", _boom)
+
+    result = auth_service.authenticate("ali", "secret123")
+
+    assert result["ID"] == 1
