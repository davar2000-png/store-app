+# -*- coding: utf-8 -*-
+"""
+Phase 16C — تست‌های end-to-end لایه‌ی HTTP احراز هویت وب.
+
+این تست‌ها لایه‌ی auth_service/web_session_service را monkeypatch می‌کنند
+تا به هیچ دیتابیس واقعی نیاز نداشته باشند - دقیقاً همان اصلی که
+tests/test_web_skeleton.py هم دنبال می‌کند (فقط لایه‌ی HTTP، بدون DB واقعی).
+"""
+
+from fastapi.testclient import TestClient
+
+from web.app import app
+from services.auth_service import InvalidCredentials, WrongPassword
+import web.app as web_app
+
+client = TestClient(app)
+
+FAKE_USER = {"ID": 7, "Username": "ali", "FullName": "علی محمدی", "IsAdmin": False}
+
+
+def setup_function():
+    client.cookies.clear()
+
+
+# --------------------------------------------------------------------------
+# دسترسی بدون احراز هویت
+# --------------------------------------------------------------------------
+
+def test_home_without_cookie_redirects_to_login():
+    response = client.get("/", follow_redirects=False)
+    assert response.status_code == 303
+    assert response.headers["location"] == "/login"
+
+
+def test_home_without_cookie_follows_to_login_page():
+    response = client.get("/")
+    assert response.status_code == 200
+    assert "ورود" in response.text
+
+
+def test_login_page_renders_form():
+    response = client.get("/login")
+    assert response.status_code == 200
+    assert "name=\"username\"" in response.text
+    assert "name=\"password\"" in response.text
+
+
+def test_health_does_not_require_auth():
+    response = client.get("/health")
+    assert response.status_code == 200
+
+
+# --------------------------------------------------------------------------
+# ورود موفق
+# --------------------------------------------------------------------------
+
+def test_successful_login_sets_cookie_and_redirects_home(monkeypatch):
+    monkeypatch.setattr(web_app, "authenticate", lambda u, p: FAKE_USER)
+    monkeypatch.setattr(web_app.web_session_service, "create_web_session", lambda uid: "fake-token-123")
+
+    response = client.post(
+        "/login",
+        data={"username": "ali", "password": "secret123"},
+        follow_redirects=False,
+    )
+
+    assert response.status_code == 303
+    assert response.headers["location"] == "/"
+    assert response.cookies.get(web_app.web_session_service.COOKIE_NAME) == "fake-token-123"
+
+
+def test_authenticated_home_shows_username(monkeypatch):
+    monkeypatch.setattr(web_app.web_session_service, "get_user_for_token", lambda token: FAKE_USER)
+    client.cookies.set(web_app.web_session_service.COOKIE_NAME, "any-token")
+
+    response = client.get("/")
+
+    assert response.status_code == 200
+    assert "علی محمدی" in response.text
+
+
+def test_login_page_redirects_away_if_already_authenticated(monkeypatch):
+    monkeypatch.setattr(web_app.web_session_service, "get_user_for_token", lambda token: FAKE_USER)
+    client.cookies.set(web_app.web_session_service.COOKIE_NAME, "any-token")
+
+    response = client.get("/login", follow_redirects=False)
+
+    assert response.status_code == 303
+    assert response.headers["location"] == "/"
+
+
+# --------------------------------------------------------------------------
+# ورود ناموفق
+# --------------------------------------------------------------------------
+
+def test_login_invalid_credentials_shows_error_without_setting_cookie(monkeypatch):
+    def _raise(u, p):
+        raise InvalidCredentials("نام کاربری یافت نشد یا غیرفعال است.")
+
+    monkeypatch.setattr(web_app, "authenticate", _raise)
+
+    response = client.post("/login", data={"username": "nobody", "password": "x"})
+
+    assert response.status_code == 401
+    assert "نام کاربری یافت نشد" in response.text
+    assert web_app.web_session_service.COOKIE_NAME not in response.cookies
+
+
+def test_login_wrong_password_shows_error(monkeypatch):
+    def _raise(u, p):
+        raise WrongPassword("رمز عبور اشتباه است.")
+
+    monkeypatch.setattr(web_app, "authenticate", _raise)
+
+    response = client.post("/login", data={"username": "ali", "password": "wrong"})
+
+    assert response.status_code == 401
+    assert "رمز عبور اشتباه است" in response.text
+
+
+def test_login_database_error_shows_connection_error(monkeypatch):
+    def _raise(u, p):
+        raise RuntimeError("no ODBC driver")
+
+    monkeypatch.setattr(web_app, "authenticate", _raise)
+
+    response = client.post("/login", data={"username": "ali", "password": "x"})
+
+    assert response.status_code == 503
+    assert "اتصال به دیتابیس" in response.text
+
+
+# --------------------------------------------------------------------------
+# خروج (Logout)
+# --------------------------------------------------------------------------
+
+def test_logout_clears_cookie_and_redirects_to_login(monkeypatch):
+    destroyed = {}
+    monkeypatch.setattr(
+        web_app.web_session_service,
+        "destroy_web_session",
+        lambda token: destroyed.setdefault("token", token),
+    )
+    client.cookies.set(web_app.web_session_service.COOKIE_NAME, "token-to-kill")
+
+    response = client.post("/logout", follow_redirects=False)
+
+    assert response.status_code == 303
+    assert response.headers["location"] == "/login"
+    assert destroyed["token"] == "token-to-kill"
