+def get_user_by_id(user_id: int):
+    """
+    اطلاعات یک کاربر را با شناسه (ID) برمی‌گرداند — فقط برای نمایش در
+    صفحات محافظت‌شده وب (Phase 16D)، مثل Dashboard، پس از احراز هویت
+    Session. هیچ رمز عبوری اینجا بررسی نمی‌شود؛ فقط SELECT از جدول
+    موجود Users است.
+
+    خروجی: دیکشنری اطلاعات کاربر (بدون PasswordHash/PasswordSalt) یا
+    None اگر کاربری با این ID یافت نشود یا غیرفعال باشد.
+    """
+    db = Database()
+    try:
+        user = db.fetch_one(
+            "SELECT * FROM Users WHERE ID = ? AND IsActive = 1",
+            (user_id,),
+        )
+    finally:
+        db.close()
+
+    if not user:
+        return None
+
+    return {k: v for k, v in user.items() if k not in _SENSITIVE_USER_FIELDS}
+
