+{% extends "base.html" %}
+
+{% block content %}
+    <section class="dashboard-box">
+        {% if user %}
+            <h2>خوش آمدید، {{ user.FullName or user.Username }}</h2>
+            <p class="dashboard-username">نام کاربری: {{ user.Username }}</p>
+        {% else %}
+            <h2>پیشخوان</h2>
+        {% endif %}
+
+        <p>
+            این نسخه‌ی Dashboard فقط خواندنی است. هیچ‌کدام از فرآیندهای واقعی
+            فروش، خرید یا حسابداری هنوز از طریق مرورگر در دسترس نیستند.
+        </p>
+        <p>
+            برای بررسی وضعیت سرور و اتصال دیتابیس به آدرس
+            <code>/health</code> مراجعه کنید.
+        </p>
+
+        <button id="logout-button">خروج</button>
+    </section>
+
+    <script>
+        // فقط همان POST /logout موجود از Phase16C را فراخوانی می‌کند — هیچ
+        // منطق جدید خروج اینجا نوشته نشده است.
+        document.getElementById("logout-button").addEventListener("click", async function () {
+            await fetch("/logout", { method: "POST" });
+            window.location.href = "/login";
+        });
+    </script>
+{% endblock %}
