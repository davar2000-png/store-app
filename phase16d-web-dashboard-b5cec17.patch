+# -*- coding: utf-8 -*-
+"""
+Phase 16D — تست‌های Auth Gate، صفحه HTML Login و Dashboard خواندنی.
+
+این تست‌ها هیچ منطق Auth/Session جدیدی را دوباره تست نمی‌کنند (آن‌ها در
+tests/test_auth_service.py و tests/test_web_session_service.py پوشش داده
+شده‌اند) — فقط بررسی می‌کنند که `/`، `/login` و `/dashboard` بر اساس همان
+Session موجود (از Phase16C) رفتار درستی داشته باشند.
+"""
+
+from fastapi.testclient import TestClient
+
+import services.auth_service as auth_service
+import services.web_session_service as web_session_service
+from tests._fake_database import FakeDatabase
+from utils.security import hash_password
+from web.app import app
+
+client = TestClient(app)
+
+
+def setup_function():
+    FakeDatabase.reset()
+    auth_service.Database = FakeDatabase
+    web_session_service.Database = FakeDatabase
+    client.cookies.clear()
+
+    password_hash, salt = hash_password("correct-horse")
+    FakeDatabase.users = [
+        {
+            "ID": 1,
+            "Username": "davar",
+            "PasswordHash": password_hash,
+            "PasswordSalt": salt,
+            "FullName": "Davar",
+            "IsAdmin": True,
+            "IsActive": True,
+            "LastLogin": None,
+        }
+    ]
+
+
+def test_login_page_returns_200_html_form():
+    response = client.get("/login")
+    assert response.status_code == 200
+    assert "text/html" in response.headers["content-type"]
+    assert "login-form" in response.text
+
+
+def test_dashboard_without_session_redirects_to_login():
+    response = client.get("/dashboard")
+    assert response.status_code == 200  # TestClient دنبال Redirect می‌رود
+    assert "login-form" in response.text
+
+
+def test_dashboard_with_valid_session_shows_username():
+    client.post("/login", json={"username": "davar", "password": "correct-horse"})
+
+    response = client.get("/dashboard")
+
+    assert response.status_code == 200
+    assert "davar" in response.text
