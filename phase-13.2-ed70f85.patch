             )
+            # (Phase 13.2) فاکتور با موفقیت ثبت شد؛ Draft مربوطه (در صورت وجود) بسته می‌شود
+            if self.draft_id:
+                try:
+                    draft_service.complete_draft(self.draft_id)
+                except Exception:
+                    logger.exception("خطا در نهایی‌کردن Draft بعد از ثبت فاکتور خرید")
+                finally:
+                    self.draft_id = None
+
