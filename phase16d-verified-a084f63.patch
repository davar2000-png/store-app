+# -*- coding: utf-8 -*-
+"""
+Phase 16D — تست‌های Dashboard محافظت‌شده (Auth-gate روی `/`).
+
+این تست‌ها فقط لایه HTTP (FastAPI) را از طریق FakeDatabase بررسی می‌کنند؛
+به هیچ SQL Server واقعی نیاز ندارند. منطق validate_session خودش قبلاً در
+tests/test_web_session_service.py پوشش داده شده — اینجا فقط اتصال صحیح
+آن به route محافظت‌شده `/` بررسی می‌شود.
+"""
+
+from fastapi.testclient import TestClient
+
+import services.auth_service as auth_service
+import services.web_session_service as web_session_service
+import web.app as web_app
+from tests._fake_database import FakeDatabase
+from utils.security import hash_password
+from web.app import app
+
+client = TestClient(app)
+
+
+def setup_function():
+    FakeDatabase.reset()
+    auth_service.Database = FakeDatabase
+    web_session_service.Database = FakeDatabase
+    web_app.Database = FakeDatabase
+    client.cookies.clear()
+
+    password_hash, salt = hash_password("correct-horse")
+    FakeDatabase.users = [
+        {
+            "ID": 1,
+            "Username": "davar",
+            "PasswordHash": password_hash,
+            "PasswordSalt": salt,
+            "FullName": "Davar",
+            "IsAdmin": True,
+            "IsActive": True,
+            "LastLogin": None,
+        }
+    ]
+
+
+def _login():
+    return client.post(
+        "/login",
+        json={"username": "davar", "password": "correct-horse"},
+    )
+
+
+def test_dashboard_requires_login():
+    response = client.get("/", follow_redirects=False)
+    assert response.status_code == 303
+    assert response.headers["location"] == "/login-page"
+
+
+def test_dashboard_with_valid_session():
+    login_response = _login()
+    assert login_response.status_code == 200
+
+    response = client.get("/")
+    assert response.status_code == 200
+    assert "Davar" in response.text
+    # کاربر IsAdmin=True است، پس ماژول Placeholder مربوط به ادمین باید دیده شود.
+    assert "مدیریت کاربران" in response.text
+
+
+def test_logout_invalidates_session():
+    _login()
+
+    # قبل از logout، Dashboard باید بدون redirect در دسترس باشد.
+    assert client.get("/", follow_redirects=False).status_code == 200
+
+    logout_response = client.post("/logout")
+    assert logout_response.status_code == 200
+
+    # بعد از logout، همان Cookie دیگر نباید Session معتبری را نشان بدهد.
+    response = client.get("/", follow_redirects=False)
+    assert response.status_code == 303
+    assert response.headers["location"] == "/login-page"
