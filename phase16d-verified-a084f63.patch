+def get_current_user(request: Request) -> Optional[dict]:
+    """
+    Dependency برای Auth-gate کردن route ها (Phase 16D).
+
+    این تابع صرفاً یک wrapper است: هیچ منطق Auth/Session جدیدی اینجا
+    نوشته نمی‌شود و رفتار web_session_service.validate_session تغییر
+    نمی‌کند. فقط توکن خام را از Cookie می‌خواند، آن را به
+    validate_session موجود می‌دهد، و در صورت معتبر بودن Session، اطلاعات
+    غیرحساس کاربر (بدون PasswordHash/PasswordSalt) را برای نمایش در
+    Template برمی‌گرداند.
+
+    خروجی: دیکشنری کاربر در صورت Session معتبر، یا None در غیر این صورت
+    (Session نبود، منقضی شده، یا باطل شده بود).
+    """
+    raw_token = request.cookies.get(SESSION_COOKIE_NAME)
+    user_id = web_session_service.validate_session(raw_token)
+    if user_id is None:
+        return None
+    return _fetch_user_public_fields(user_id)
+
+
+def _fetch_user_public_fields(user_id: int) -> Optional[dict]:
+    """
+    یک SELECT ساده و فقط‌خواندنی روی جدول موجود Users برای نمایش نام
+    کاربر در Dashboard. هیچ جدول یا ستون جدیدی نمی‌سازد و به هیچ داده‌ی
+    مالی Legacy دست نمی‌زند.
+    """
+    if Database is None:
+        return None
+
+    db = Database()
+    try:
+        user = db.fetch_one("SELECT * FROM Users WHERE ID = ?", (user_id,))
+    finally:
+        db.close()
+
+    if not user:
+        return None
+
+    return {k: v for k, v in user.items() if k not in ("PasswordHash", "PasswordSalt")}
+
+
+def _derive_allowed_modules(user: dict) -> list:
+    """
+    لیست Placeholder از ماژول‌های در دسترس کاربر — فعلاً فقط بر اساس
+    پرچم موجود IsAdmin مشتق می‌شود. این Skeleton است، نه یک سیستم
+    Permission واقعی؛ به هیچ جدول Permission/Module جدیدی متصل نیست و
+    هیچ داده‌ی مالی (Transaction/Factors/DocHeader) را کوئری نمی‌کند.
+    """
+    modules = ["پیشخوان"]
+    if user.get("IsAdmin"):
+        modules.append("مدیریت کاربران (Placeholder — پیاده‌سازی‌نشده)")
+    return modules
+
